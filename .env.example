# Copy to .env and adjust locally.

# Claude Code accepts aliases such as sonnet/opus, or full IDs such as claude-sonnet-4-6.
KRW_ONTOLOGY_ROOT=~/krw-ontology-data
KRW_MODEL=sonnet

KRW_AI_CONCURRENCY=10
KRW_MAX_TURNS=10
KRW_CALL_TIMEOUT_SECONDS=600
KRW_FAIL_ON_SECTION_QUALITY=false
KRW_SPAN_PRUNING=conservative
KRW_CHART_SERIES_ENABLED=0
KRW_MCP_FAST_LANE_CONCURRENCY=8
KRW_MCP_BROAD_LANE_CONCURRENCY=2
KRW_MCP_DIAGNOSTIC_LANE_CONCURRENCY=1
KRW_ROUTER_TICKERLESS_QUERY_CONTEXT_MAX_TICKERS=5

KRW_STAGE_MODEL_EXTRACT_EVIDENCE_QUOTES=sonnet
KRW_STAGE_MODEL_EXTRACT_RESEARCH_CLAIMS=sonnet
KRW_STAGE_MODEL_EXTRACT_ASSUMPTION_CANDIDATES=opus

KRW_STAGE_CONCURRENCY_EXTRACT_EVIDENCE_QUOTES=10
KRW_STAGE_CONCURRENCY_EXTRACT_RESEARCH_CLAIMS=10
KRW_STAGE_CONCURRENCY_EXTRACT_ASSUMPTION_CANDIDATES=10

KRW_BATCH_SIZE_QUOTE_EXTRACTION=10
KRW_BATCH_SIZE_CLAIM_EXTRACTION=12
