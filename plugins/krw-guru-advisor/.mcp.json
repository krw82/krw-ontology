{
  "mcpServers": {
    "krw-guru-advisor": {
      "command": "uv",
      "args": [
        "--directory",
        "${HOME}/krw-ontology",
        "run",
        "krw-guru-advisor-mcp"
      ],
      "env": {
        "KRW_GURU_ENV": "prod",
        "KRW_GURU_DATA_ROOT": "${HOME}/krw-ontology-guru-data",
        "KRW_GURU_RELEASE_ROOT": "${HOME}/krw-ontology-guru-data/releases/prod/current"
      }
    }
  }
}
